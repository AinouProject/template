{
  "extends": "../tsconfig/tsconfig.json",

  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@example/shared": ["../shared/src/index.ts"] },
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },

  "include": ["src", "vite.config.ts"]
}
