{
  "name": "@example/server",
  "type": "module",
  "dependencies": {
    "@example/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "lodash": "^4.17.21",
    "nestjs-zod": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/swagger": "^11.2.0",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/debug": "^4.1.12",
    "@types/lodash": "^4.17.20",
    "jiti": "^2.5.1",
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "watch": "swc --source-maps --copy-files --out-dir dist --strip-leading-paths --watch --log-watch-compilation src",
    "build": "rimraf dist && swc --source-maps --copy-files --out-dir dist --strip-leading-paths src",
    "dev": "node --watch-path=./src --watch-preserve-output --import jiti/register --require tsconfig-paths/register src/main.ts"
  }
}
