{
  "extends": "../tsconfig/tsconfig.json",

  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },

  "include": ["src"]
}
